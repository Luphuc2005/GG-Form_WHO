# ==============================================================================
# BIẾN MÔI TRƯỜNG CẤU HÌNH HỆ THỐNG KHẢO SÁT GIẢI PHẪU BỆNH
# ==============================================================================
# HƯỚNG DẪN:
# Sao chép tệp này thành .env:  cp .env.example .env
# Chỉnh sửa các giá trị bảo mật bên dưới trước khi triển khai!
# ==============================================================================

# Môi trường chạy: production hoặc development
APP_ENV=production

# Tên miền chính thức của khảo sát (Ví dụ: gpb.example.edu.vn)
DOMAIN=survey.example.edu.vn

# Cổng HTTP mà container Nginx lắng nghe trên máy chủ host
# Nếu máy chủ trường đã có sẵn Nginx: đặt là 8080 (để Nginx trường proxy vào 127.0.0.1:8080)
# Nếu máy chủ mới hoàn toàn không chạy gì khác: có thể đặt là 80
APP_HTTP_PORT=8080

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_DB=ovarian_survey
POSTGRES_USER=survey_user
POSTGRES_PASSWORD=THAY_BANG_MAT_KHAU_POSTGRES_NGUY_HIEM_NGUY_HIEM_123456

# Khóa bí mật ký mã JWT và bảo mật phiên (Tối thiểu 32 ký tự ngẫu nhiên)
SECRET_KEY=THAY_BANG_CHUOI_BI_MAT_NGAN_GON_TOI_THIEU_32_KY_TU_RANDOM_ABCXYZ

# Tài khoản Quản trị viên khởi tạo ban đầu (Admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_ADMIN_MANH_2026!

# Số lượng tiến trình xử lý Uvicorn Worker (Khuyến nghị: 2 đến 4 workers tùy CPU máy chủ)
WEB_CONCURRENCY=4

# Cấu hình Connection Pool của PostgreSQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Danh sách nguồn CORS được phép gọi API (Phân tách bằng dấu phẩy)
# Trong môi trường Production: đặt đúng domain của bạn, ví dụ: https://gpb.example.edu.vn
CORS_ORIGINS=*

# Bật/tắt trang tài liệu Swagger UI /docs trên môi trường production (true/false)
ENABLE_DOCS=false

# Tự động nạp dữ liệu mẫu thử nghiệm (Mặc định production là false)
SEED_DEMO_DATA=false

# Tùy chọn: Kết nối trực tiếp Google Sheets theo thời gian thực (Webhook URL từ Apps Script)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/....../exec
# ID trong URL Google Sheet, dùng để đọc CSV ở gid=0 và đối chiếu mã phiếu.
# Tài khoản chạy backend cần đọc được bản xuất CSV; không tự động đổi quyền chia sẻ.
# GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
