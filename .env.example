# Copy to .env at the repository root for Docker Compose.
APP_ENV=production
DOMAIN=survey.example.edu.vn
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080

POSTGRES_DB=ovarian_survey
POSTGRES_USER=survey_user
# Required. On a fresh install, openssl rand -hex 32 generates a URL-safe password.
# For an existing volume, keep its actual PostgreSQL credentials.
POSTGRES_PASSWORD=
# Optional override for a fully formed SQLAlchemy URL (percent-encode special password characters).
# DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/ovarian_survey

# Required. Generate a separate openssl rand -hex 32 value.
SECRET_KEY=
ADMIN_USERNAME=admin
# Required. Bootstrap password for a new account.
ADMIN_PASSWORD=

CORS_ORIGINS=https://survey.example.edu.vn
ENABLE_DOCS=false
WEB_CONCURRENCY=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
SHEETS_SYNC_BATCH_SIZE=100
EXPORT_TTL_HOURS=24
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7
# When DATABASE_URL targets an external database, configure its backup host/port
# and matching POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD above.
# BACKUP_PGHOST=postgres.example.internal
# BACKUP_PGPORT=5432
# BACKUP_PGDATABASE=ovarian_survey
# BACKUP_PGUSER=survey_user
# BACKUP_PGPASSWORD=

# Optional integration. Leave all three blank to keep data in PostgreSQL only.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Generate a separate openssl rand -hex 32 value and set the same value in Apps Script.
GOOGLE_SHEETS_WEBHOOK_TOKEN=
